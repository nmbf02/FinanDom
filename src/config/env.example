# Configuración de Google Sign-In
# Obtener estos valores desde Google Cloud Console > APIs & Services > Credentials

# Web Client ID (tipo "Web application")
GOOGLE_WEB_CLIENT_ID=tu-web-client-id.apps.googleusercontent.com

# Android Client ID (tipo "Android") - ya está en google-services.json
GOOGLE_ANDROID_CLIENT_ID=tu-android-client-id.apps.googleusercontent.com

# API Key de Google
GOOGLE_API_KEY=tu-api-key

# Configuración del backend
BACKEND_URL=http://localhost:3000
JWT_SECRET=tu-jwt-secret-super-seguro
